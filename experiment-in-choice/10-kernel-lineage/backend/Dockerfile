# Stage 1: Build the Go SQLite binary with full GCC compilation bindingsFROM golang:1.21-alpine AS builderRUN apk add --no-cache gcc musl-devWORKDIR /appCOPY go.mod ./# Add and initialize necessary sqlite dependencies module referencesRUN go get ://github.com && go mod tidy || touch go.modCOPY main.go .RUN CGO_ENABLED=1 GOOS=linux go build -a -ldflags '-extldflags "-static"' -o main .
# Stage 2: Deploy execution layerFROM alpine:latest  RUN apk --no-cache add ca-certificatesWORKDIR /root/COPY --from=builder /app/main .# Expose the communication array portsEXPOSE 8080CMD ["./main"]
