# Stage 1: Native binary compilation inside lightweight Linux containerFROM golang:1.21-alpine AS builderWORKDIR /appCOPY go.mod ./RUN go mod download || touch go.modCOPY main.go .RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main .
# Stage 2: Final runtime execution target environmentFROM alpine:latest  RUN apk --no-cache add ca-certificatesWORKDIR /root/COPY --from=builder /app/main .EXPOSE 8080CMD ["./main"]
